  "keywords": [
    "nodejs",
    "express",
    "rest-api",
    "javascript",
    "backend",
    "layered-architecture",
    "supertest",
    "tutorial"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nemo-crypto/express.git"
  }
}
