{
  "name": "express-learning-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/server.js && npm test",
    "demo:dex": "node scripts/dex-demo.mjs"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
